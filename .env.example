# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (Vercel URL in production)
CLIENT_ORIGIN=http://localhost:3000

# ─── Database ──────────────────────────────────────────────
# MongoDB Atlas connection string (Database > Connect > Drivers), used as-is.
# Use a database user scoped to readWrite on MONGODB_DB_NAME only.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=doctor_tracker

# ─── Auth (JWT) ────────────────────────────────────────────
# Two different long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<random-string-1>
JWT_REFRESH_SECRET=<random-string-2>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed (demo accounts created by `npm run seed`) ────────
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_VIEWER_EMAIL=viewer@doctortracker.dev
SEED_VIEWER_PASSWORD=<choose-a-password>

# ─── AI ────────────────────────────────────────────────────
# Provider behind the AIService interface. Leave GEMINI_API_KEY empty to run
# with AI features disabled (the app falls back to manual filters).
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-google-ai-studio-key>
# Chosen by measured latency/reliability on the free tier. The fallback is
# used automatically when the primary is overloaded (503), times out or is retired.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Per-attempt timeout in milliseconds (primary, primary retry, fallback).
AI_TIMEOUT_MS=8000
